{
  "$schema": "./keymap.schema.json",
  "bindings": [
    {
      "bindings": {
        "g r": "demo::open_recent",
        "p": "demo::open_palette",
        "w": "demo::move_selection"
      }
    },
    {
      "context": "browsing",
      "bindings": {
        "enter": "demo::open_palette"
      }
    },
    {
      "context": "editing",
      "bindings": {
        "enter": "demo::submit_edit"
      }
    }
  ]
}
